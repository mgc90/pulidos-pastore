---
const slides = [
	{
		type: 'video',
		src: `${import.meta.env.BASE_URL}video/istockphoto-2219920322-640_adpp_is.mp4`,
		title: 'Reviví tus pisos',
		subtitle: 'Tratamiento de alta calidad',
	},
	{
		type: 'image',
		src: `${import.meta.env.BASE_URL}imgs/obra1.jpg`,
		title: 'Plastificado ultra resistente',
		subtitle: 'Múltiples capas de alto tránsito',
	},
	{
		type: 'image',
		src: `${import.meta.env.BASE_URL}imgs/obra2.jpg`,
		title: 'Parquet, Desk, Mosaicos',
		subtitle: 'Laca, HidroLaca, Termovitrificado',
	},
	{
		type: 'image',
		src: `${import.meta.env.BASE_URL}imgs/obra3.jpg`,
		title: 'Pulidos Pastore',
		subtitle: 'Una vida familiar en el rubro',
	},
];
---

<section
	id="hero"
	class="relative h-[70vh] w-full overflow-hidden bg-marble"
	data-slides={JSON.stringify(slides)}
>
	<div class="absolute inset-0">
		{
			slides.map((slide, i) =>
				slide.type === 'video' ? (
					<video
						class:list={['hero-slide', { active: i === 0 }]}
						src={slide.src}
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
					/>
				) : (
					<img
						class:list={['hero-slide', { active: i === 0 }]}
						src={slide.src}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				),
			)
		}
	</div>

	<div class="absolute inset-0 bg-black/50"></div>

	<div class="relative z-10 flex h-full flex-col items-center justify-center px-4 text-center">
		<h1 id="hero-title" class="hero-text text-shadow-brand text-4xl font-semibold tracking-wide text-wood-light md:text-6xl">
			{slides[0].title}
		</h1>
		<p id="hero-subtitle" class="hero-text text-shadow-brand mt-4 text-lg text-marble-shine md:text-3xl">
			{slides[0].subtitle}
		</p>
	</div>
</section>

<style>
	.hero-slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 1s ease-in-out;
	}

	.hero-slide.active {
		opacity: 1;
	}

	.hero-text {
		transition: opacity 0.5s ease-in-out;
	}

	.hero-text-fade {
		opacity: 0;
	}
</style>

<script>
	const hero = document.getElementById('hero');
	const slides = JSON.parse(hero?.dataset.slides ?? '[]') as {
		type: string;
		src: string;
		title: string;
		subtitle: string;
	}[];
	const titleEl = document.getElementById('hero-title');
	const subtitleEl = document.getElementById('hero-subtitle');
	const media = Array.from(document.querySelectorAll('.hero-slide'));

	let current = 0;
	let textTimeout: number | undefined;

	const showText = (index: number) => {
		titleEl?.classList.add('hero-text-fade');
		subtitleEl?.classList.add('hero-text-fade');
		window.clearTimeout(textTimeout);
		textTimeout = window.setTimeout(() => {
			if (titleEl) titleEl.textContent = slides[index].title;
			if (subtitleEl) subtitleEl.textContent = slides[index].subtitle;
			titleEl?.classList.remove('hero-text-fade');
			subtitleEl?.classList.remove('hero-text-fade');
		}, 500);
	};

	setInterval(() => {
		media[current]?.classList.remove('active');
		current = (current + 1) % slides.length;
		media[current]?.classList.add('active');
		showText(current);
	}, 7000);
</script>
